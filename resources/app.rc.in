// 由 cmake/Version.cmake 生成到构建目录（<build>/generated/app.rc）。
// 改版本号请改仓库根目录的 VERSION 文件，不要改这个模板里的版本字段。
#include <windows.h>

1 24 "@YUMEIREN_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 // 数字型版本只能用 4 个 16 位整数，装不下 "+提交数.g短sha" 这类后缀，
 // 所以这里固定用基础版本的 4 段形式（1,0,0,0）。
 FILEVERSION @YUMEIREN_VERSION_NUMERIC@
 PRODUCTVERSION @YUMEIREN_VERSION_NUMERIC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "虞美人"
            // FileVersion 给机器读，保持 4 段数字；
            // ProductVersion 给人读（也供 CI 断言），用完整版本串 ——
            // 从文件属性里就能看出这是发布版还是本地开发版。
            VALUE "FileVersion", "@YUMEIREN_VERSION_NUMERIC_STRING@"
            VALUE "ProductVersion", "@YUMEIREN_VERSION_FULL@"
            VALUE "ProductName", "Yumeiren"
            VALUE "OriginalFilename", "Yumeiren.exe"
            VALUE "LegalCopyright", "MIT / LGPL - integrates ExplorerBgTool & ExplorerBlurMica"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
