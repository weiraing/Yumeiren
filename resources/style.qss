/* Yumeiren — dark theme (modern / minimal / elegant) */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    outline: none;
}

QMainWindow, QDialog {
    background: #16171b;
}

/* ---------- sidebar ---------- */
#Sidebar {
    background: #101114;
    border: none;
    border-right: 1px solid #232428;
}

#AppTitle {
    color: #f2f3f6;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 22px 20px 0 20px;
}

#AppSubtitle {
    color: #63666f;
    font-size: 11px;
    padding: 3px 20px 18px 20px;
}

QListWidget#NavList {
    background: transparent;
    border: none;
    color: #9a9daa;
    font-size: 13px;
    padding: 0 12px;
}

QListWidget#NavList::item {
    padding: 10px 12px;
    border-radius: 9px;
    margin: 3px 0;
    border-left: 3px solid transparent;
}

QListWidget#NavList::item:hover {
    background: #1a1b20;
    color: #e9eaee;
}

QListWidget#NavList::item:selected {
    background: #21273a;
    border-left: 3px solid #4f8cff;
    color: #ffffff;
    font-weight: 600;
}

#SideFooter {
    color: #585b64;
    font-size: 11px;
    padding: 6px 20px;
}

/* ---------- sidebar bottom card ---------- */
QFrame#SideCard {
    background: #1b1c21;
    border: 1px solid #26272d;
    border-radius: 10px;
}

QFrame#SideCardSep {
    background: #26272d;
    border: none;
    max-height: 1px;
}

QLabel#EnvAdminLabel {
    color: #e0a94f;
    font-size: 12px;
}

QLabel#EnvAdminLabel[data-admin="1"] {
    color: #7dc483;
}

QLabel#EnvOsLabel {
    color: #7c7f8a;
    font-size: 11px;
}

QLabel#EnvVersionLabel {
    color: #7c7f8a;
    font-size: 11px;
}

QLabel#ThemeLabel {
    color: #9a9daa;
    font-size: 13px;
}

/* ---------- header / status ---------- */
#Header {
    background: #16171b;
    border: none;
    border-bottom: 1px solid #232428;
}

#HeaderTitle {
    color: #f2f3f6;
    font-size: 15px;
    font-weight: 600;
}

#HeaderSub {
    color: #63666f;
    font-size: 12px;
}

QLabel#StatusChip {
    border-radius: 9px;
    padding: 3px 11px;
    font-size: 12px;
    color: #b9bcc4;
    background: #212228;
    border: 1px solid #2a2b31;
    margin-left: 6px;
}

QLabel#StatusChip[data-ok="1"] {
    background: #14261d;
    border: 1px solid #1f4a33;
    color: #7fdfa8;
}

QLabel#StatusChip[data-warn="1"] {
    background: #2a2313;
    border: 1px solid #55431c;
    color: #f4c977;
}

/* ---------- header tabs ---------- */
QPushButton#HeaderTab {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #9a9daa;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#HeaderTab:hover { color: #e9eaee; background: #22232a; }

QPushButton#HeaderTab:checked { color: #7db1ff; background: #21273a; }

QPushButton#HeaderTab:focus { border: none; }

/* ---------- pages ---------- */
#ContentArea { background: #16171b; }

#PageCard {
    background: #1c1d22;
    border: 1px solid #26272d;
    border-radius: 14px;
}

#GroupTitle {
    color: #f2f3f6;
    font-size: 13px;
    font-weight: 600;
}

#HintLabel {
    color: #7c7f8a;
    font-size: 12px;
}

/* 提示语变成「当前做不了这件事」时的样子：入口置灰的同时必须让原因可见 ——
   禁用控件未必收得到 tooltip。写方 setProperty("data-err", 1) 即可复用。 */
#HintLabel[data-err="1"] { color: #e58a92; }

/* 看板娘页「模型」卡片刷新行右端的问号徽标(2026-09-18 起取代原来那段
   「把 Cubism3/4 模型整个文件夹放进…」的常驻说明文字，内容移进它的 tooltip)。
   它是 QLabel 不是按钮：尺寸由 setFixedSize(22,22) 定死，圆角取一半即正圆，
   所以这里**不要写 padding** —— 一写就把问号挤歪、圆也不圆了。
   悬浮换色是为了让「这里挂着提示」这件事看得出来。 */
#HelpBadge {
    color: #8a8d99;
    border: 1px solid #3a3b45;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
}

#HelpBadge:hover {
    color: #e9eaee;
    border: 1px solid #4f8cff;
}

QLabel#FieldLabel {
    color: #b9bcc4;
    font-size: 12px;
}

/* ---------- preset cards ---------- */
QPushButton#PresetCard {
    background: #212228;
    border: 1px solid #2a2b31;
    border-radius: 10px;
    padding: 3px;
}

QPushButton#PresetCard:hover {
    border: 1px solid #3d3f48;
    background: #25262d;
}

QPushButton#PresetCard:checked {
    border: 2px solid #4f8cff;
    background: #212228;
}

QLabel#PresetName {
    color: #9a9daa;
    font-size: 11px;
}

/* ---------- focus ---------- */
QComboBox:focus { border: 1px solid #4f8cff; }

QPushButton:focus { border: 1px solid #4f8cff; }
QPushButton#PrimaryButton:focus { border: none; background: #4a7ce4; }

QPushButton#PrimaryButton[data-active="0"] {
    background: transparent;
    border: 1px solid #2c2d34;
    color: #b9bcc4;
    font-weight: 600;
}

QPushButton#PrimaryButton[data-active="0"]:hover { background: #22232a; }

QPushButton#PrimaryButton[data-active="0"]:focus {
    border: 1px solid #4f8cff;
    background: transparent;
}

QPushButton#PrimaryButton[data-active="0"]:disabled { border: 1px solid #26272d; }

QPushButton#PrimaryButton[data-active="1"] {
    background: #c0392b;
    border: none;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#PrimaryButton[data-active="1"]:hover { background: #d44637; }
QPushButton#PrimaryButton[data-active="1"]:pressed { background: #a93226; }
QPushButton#PrimaryButton[data-active="1"]:disabled { background: #5c2228; color: #8a5a5e; border: 1px solid #5c2228; }

QListWidget#NavList:focus { border: none; }
QSlider:focus { background: transparent; }
QCheckBox { border: none; }
QCheckBox:focus { border: none; }
QCheckBox::indicator:focus { border: 1px solid #4f8cff; }
QRadioButton { border: none; }
QRadioButton:focus { border: none; }
QSlider { border: none; }
QSlider:focus { border: none; }

/* ---------- scrollbars ---------- */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #31323a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #3d3f48; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #31323a;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- sliders ---------- */
QSlider { min-height: 22px; }

QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: #2c2d34;
}

QSlider::sub-page:horizontal {
    background: #4f8cff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #f2f3f6;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover { background: #ffffff; }

/* ---------- combo / checkbox ---------- */
QComboBox {
    background: rgba(255, 255, 255, 0.06);
    color: #e9eaee;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 6px 10px 6px 12px;
    font-size: 13px;
    min-height: 18px;
}

/* The border is always 1px wide so focusing cannot resize the box. */
QComboBox:hover { background: rgba(255, 255, 255, 0.12); }
QComboBox:focus, QComboBox:pressed { background: rgba(255, 255, 255, 0.14); border-color: #4f8cff; }
QComboBox:disabled { color: #5a5d66; background: rgba(255, 255, 255, 0.03); }

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7c7f8a;
    margin-right: 9px;
}

QComboBox:disabled::down-arrow { border-top-color: #3a3c44; }

/* The popup is a top-level frame of its own, and that frame owns the rounded
   panel; C++ clips its corners to the same radius and insets the list by 6px, which
   Qt counts when it sizes the popup, so every row gets shown and none of them is
   flush against a corner. The list in front of the panel stays a flat inner surface,
   so the two never read as a border inside a border. */
QFrame#ComboContainer {
    background: #212228;
    border: 1px solid #33343c;
    border-radius: 12px;
}

QAbstractItemView#ComboPopup {
    background: #212228;
    color: #e9eaee;
    border: none;
    padding: 0;
    outline: none;
    show-decoration-selected: 0;
    /* The row height in C++ is measured from this font, so it belongs on the list
       itself rather than on ::item, where it would only be applied while painting. */
    font-size: 13px;
}

QAbstractItemView#ComboPopup::item {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 2px 3px;
    color: #c9ccd4;
}

QAbstractItemView#ComboPopup::item:hover { background: rgba(255, 255, 255, 0.08); }

QAbstractItemView#ComboPopup::item:selected {
    background: #2c3a5e;
    color: #ffffff;
    font-weight: 600;
}

/* ---------- popup menus (看板娘右键菜单 / 托盘菜单) ----------
   与 #ComboContainer、QToolTip 同属一族「浮层表面」：细描边 + 扁平底色，
   只是内容换成了动作列表。

   尺度整体收小一档(2026-09-17)：字 13→12px(与正文 12px 对齐)、外内边距 4→3px、
   行内边距 5→4px、行外边距 2→1px、分隔线 3/8→2/6px。

   **外框刻意不留圆角**(2026-09-17 二次调整，实测结论)：
   QMenu 是顶层弹窗，QSS 的 border-radius 只改「画出来的那块矩形」，窗口本身仍是
   方的，圆角外侧会露出窗口底色。以前靠给窗口设 region 遮罩收口
   (menustyle::applyRoundedCorners)，但 region 是 **1 位 alpha**，圆角边缘必然是
   硬台阶；在 150% 缩放(DPI 144)下逻辑坐标转设备坐标还会把台阶放大，肉眼就是
   「圆角有粗糙像素点」。改走逐像素透明(WA_TranslucentBackground)实测更糟 ——
   圆角外侧直接渲染成黑块。所以外框改成直角：不留半径就不需要遮罩，也就没有
   台阶可看。菜单项的高亮块画在窗口**内部**、带抗锯齿，保留小圆角不受影响。 */
QMenu {
    background: #212228;
    border: 1px solid #33343c;
    padding: 3px;
    color: #e9eaee;
    font-size: 12px;
}

/* 行高：12px 字的一行约 24px(上下内边距 4px + 外边距 1px)，比上一版矮一档。
   历史：最早是 8px/2px，出来 37px 一行，十项的菜单拉到 360px 高，鼠标要跑很远
   才够得着下一项，所以一路压到现在的 4px/1px。 */
QMenu::item {
    background: transparent;
    color: #e9eaee;
    padding: 4px 13px 4px 8px;
    margin: 1px 1px;
    border-radius: 5px;
    /* 只是「不许窄成一条」，不是目标宽度：真正的宽度由最长的那行文字定
       (现为「暂停 / 恢复」)。改菜单文案会直接改变菜单宽度 —— 原来 124px 是
       「打开主界面设置」撑出来的(菜单 176px)，那句缩成「打开设置」后会跟着变窄。 */
    min-width: 76px;
}

/* 菜单没有 hover 态，高亮就是 :selected */
QMenu::item:selected { background: rgba(255, 255, 255, 0.08); color: #ffffff; }

/* 不可点的项灰得更明确，一眼能看出是「不可用」而不是「没画出来」 */
QMenu::item:disabled { color: #6b6e78; }

QMenu::separator {
    height: 1px;
    background: #33343c;
    margin: 2px 6px;
}

/* 勾选项用填色圆角块表示选中，与 QCheckBox::indicator 同一套语言。
   尺寸随字号一起收小：13→12px，圆角 4→3px。 */
QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 7px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.10);
}

QMenu::indicator:checked { background: #4f8cff; }

QMenu::indicator:disabled { background: rgba(255, 255, 255, 0.05); }

/* 二级菜单箭头：**刻意不覆盖**，交给 Fusion 画。理由见 light.qss 里同一处的长注释
   (简言之：border 拼三角在 QMenu::right-arrow 上出不来三角，贴图又要多两个资源
   文件；不覆盖时箭头颜色会跟着 `color` 走，明暗主题都对)。 */

QCheckBox {
    color: #9a9daa;
    font-size: 12px;
    spacing: 8px;
}

QCheckBox:hover { color: #e9eaee; }

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.10);
}

QCheckBox::indicator:hover { background: rgba(255, 255, 255, 0.22); }

QCheckBox::indicator:checked {
    background: #4f8cff;
    border: none;
}

/* 播放模式单选框：外圈常驻描边，选中时内圈填色(纯 QSS，无位图资源) */
QRadioButton {
    color: #9a9daa;
    font-size: 12px;
    spacing: 5px;
}

QRadioButton:hover { color: #e9eaee; }

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #45474f;
    border-radius: 8px;
    background: transparent;
}

QRadioButton::indicator:hover { border-color: #6d7079; }

QRadioButton::indicator:focus { border-color: #4f8cff; }

QRadioButton::indicator:checked {
    border-color: #4f8cff;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0.0 #4f8cff, stop: 0.42 #4f8cff,
        stop: 0.52 rgba(79, 140, 255, 0), stop: 1.0 rgba(79, 140, 255, 0));
}

/* ---------- buttons ---------- */
QPushButton {
    background: transparent;
    color: #b9bcc4;
    border: 1px solid #2c2d34;
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background: #22232a;
    border: 1px solid #3d3f48;
    color: #e9eaee;
}

QPushButton:disabled { color: #4c4f58; border: 1px solid #26272d; }

QPushButton#PrimaryButton {
    background: #3d6fd6;
    border: none;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 18px;
    font-size: 13px;
    border-radius: 10px;
}

QPushButton#PrimaryButton:hover { background: #4a7ce4; }
QPushButton#PrimaryButton:pressed { background: #3561bd; }
QPushButton#PrimaryButton:disabled { background: #26272e; color: #5a5d66; border: 1px solid #26272d; }

QPushButton#DangerButton {
    background: transparent;
    border: 1px solid #45262a;
    color: #e58a92;
    border-radius: 10px;
    /* Sits in the same row as PrimaryButton: the 1px border eats one of the
       10px/18px paddings, so use 9/17 to land on the identical outer box. */
    padding: 9px 17px;
    font-size: 13px;
}

QPushButton#DangerButton:hover { background: #2a1c1f; border: 1px solid #6b3a40; }

/* ---------- preview ---------- */
#PreviewFrame {
    background: #101114;
    border: 1px solid #26272d;
    border-radius: 10px;
}

#PreviewLabel { color: #63666f; font-size: 12px; }

/* ---------- log ---------- */
#LogLabel {
    color: #8a9aac;
    font-size: 12px;
}

#LogLabel[data-err="1"] { color: #e58a92; }

/* ---------- video playlist ---------- */
QListWidget#VideoList {
    background: #17181d;
    border: 1px solid #2a2b31;
    border-radius: 10px;
    padding: 4px;
}

QListWidget#VideoList::item {
    border-radius: 8px;
    margin: 1px 1px;
}

QListWidget#VideoList::item:selected { background: #33477f; }

/* 视频列表操作键: 按语义配色(扫描=青绿查找/添加=蓝主操作/删除=红危险/清空=橙批量) */
QPushButton#VideoScanButton {
    background: #0e8074; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#VideoScanButton:hover { background: #129084; }
QPushButton#VideoScanButton:pressed { background: #0b665d; }

QPushButton#VideoAddButton {
    background: #3d6fd6; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#VideoAddButton:hover { background: #4a7ce4; }
QPushButton#VideoAddButton:pressed { background: #3561bd; }

QPushButton#VideoDeleteButton {
    background: #d0403a; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#VideoDeleteButton:hover { background: #e0524c; }
QPushButton#VideoDeleteButton:pressed { background: #b0332e; }

QPushButton#VideoClearButton {
    background: #d98a26; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#VideoClearButton:hover { background: #e89a33; }
QPushButton#VideoClearButton:pressed { background: #b8731c; }


QListWidget#VideoList::item:hover { background: #26272e; }

/* 正在播放的视频条目(由条目容器上的 data-playing 属性驱动) */
QWidget[data-playing="true"] {
    background: rgba(64, 118, 227, 0.20);
    border: 1px solid rgba(64, 118, 227, 0.55);
    border-radius: 8px;
}

QLabel#VideoItemPath {
    color: #7c7f8a;
    font-size: 11px;
}

/* ---------- gallery list ---------- */
QListWidget#GalleryList {
    background: transparent;
    border: none;
}

QListWidget#GalleryList[modelCards="true"],
QListWidget#GalleryList[imageCards="true"] {
    color: #9a9daa;
}

QListWidget#GalleryList::item {
    background: #212228;
    border: 1px solid #2a2b31;
    border-radius: 10px;
    margin: 3px;
    padding: 6px 2px;
    color: #9a9daa;
}

/* 标题文字颜色恒定(浅色)，选中/悬停只变化边框与背景 */
QListWidget#GalleryList::item:hover {
    border: 1px solid #3d3f48;
    background: #25262d;
}

QListWidget#GalleryList::item:selected {
    background: #212228;
    border: 2px solid #4f8cff;
}

/* ---------- custom title bar ---------- */
QFrame#TitleBar {
    background: #17181d;
    border-bottom: 1px solid #26272d;
}

QLabel#TitleText {
    color: #d5d8de;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#TitleButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9a9daa;
    font-size: 13px;
}

QPushButton#TitleButton:hover {
    background: #2a2b31;
    color: #e9eaee;
}

QPushButton#TitleCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9a9daa;
    font-size: 13px;
}

QPushButton#TitleCloseButton:hover {
    background: #c42b1c;
    color: #ffffff;
}

/* ---------- display position grid ---------- */
QPushButton#PosButton {
    background: #212228;
    border: 1px solid #2a2b31;
    border-radius: 8px;
    padding: 4px 2px;
    color: #9a9daa;
}

QPushButton#PosButton:hover {
    border: 1px solid #3d3f48;
    background: #25262d;
}

QPushButton#PosButton:checked {
    border: 2px solid #4f8cff;
    background: #1c2740;
    color: #d5d8de;
}

QPushButton#PosButton:disabled {
    color: #4a4c55;
    background: #1b1c21;
    border: 1px solid #23242a;
}

QPushButton#ParamResetButton {
    background: transparent;
    border: 1px solid #2a2b31;
    border-radius: 6px;
    padding: 2px 10px;
    color: #8a8d99;
    font-size: 11px;
}

QPushButton#ParamResetButton:hover {
    border: 1px solid #4f8cff;
    color: #d5d8de;
}

/* ---------- tooltip ----------
   Qt 未加样式时沿用系统经典黄色气泡，与深色面板完全不搭。
   这里把提示统一成与 ComboContainer 同一族的浮层表面(深色面板 + 细描边)。
   注意：QToolTip 的窗口不含边框宽度，故用 padding 让出描边空间，避免文字被裁。 */
QToolTip {
    background-color: #212228;
    color: #c9ccd4;
    border: 1px solid #3a3b45;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
}
