/* Yumeiren — light theme (modern / minimal / elegant) */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    outline: none;
}

QMainWindow, QDialog {
    background: #f5f6f8;
}

/* ---------- sidebar ---------- */
#Sidebar {
    background: #ffffff;
    border: none;
    border-right: 1px solid #e7e8ec;
}

#AppTitle {
    color: #17181c;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 22px 20px 0 20px;
}

#AppSubtitle {
    color: #8a8d96;
    font-size: 11px;
    padding: 3px 20px 18px 20px;
}

QListWidget#NavList {
    background: transparent;
    border: none;
    color: #5f6470;
    font-size: 13px;
    padding: 0 12px;
}

QListWidget#NavList::item {
    padding: 10px 12px;
    border-radius: 9px;
    margin: 3px 0;
    border-left: 3px solid transparent;
}

QListWidget#NavList::item:hover {
    background: #f2f3f6;
    color: #17181c;
}

QListWidget#NavList::item:selected {
    background: #e8f0fd;
    border-left: 3px solid #2f6fd6;
    color: #1c4fa0;
    font-weight: 600;
}

#SideFooter {
    color: #a4a7b0;
    font-size: 11px;
    padding: 6px 20px;
}

/* ---------- sidebar bottom card ---------- */
QFrame#SideCard {
    background: #eef0f4;
    border: 1px solid #e7e8ec;
    border-radius: 10px;
}

QFrame#SideCardSep {
    background: #dfe1e6;
    border: none;
    max-height: 1px;
}

QLabel#EnvAdminLabel {
    color: #b06f1f;
    font-size: 12px;
}

QLabel#EnvAdminLabel[data-admin="1"] {
    color: #2e7d43;
}

QLabel#EnvOsLabel {
    color: #8a8f99;
    font-size: 11px;
}

QLabel#EnvVersionLabel {
    color: #8a8f99;
    font-size: 11px;
}

QLabel#ThemeLabel {
    color: #5f6470;
    font-size: 13px;
}

/* ---------- header / status ---------- */
#Header {
    background: #f5f6f8;
    border: none;
    border-bottom: 1px solid #e7e8ec;
}

#HeaderTitle {
    color: #17181c;
    font-size: 15px;
    font-weight: 600;
}

#HeaderSub {
    color: #8a8d96;
    font-size: 12px;
}

QLabel#StatusChip {
    border-radius: 9px;
    padding: 3px 11px;
    font-size: 12px;
    color: #5f6470;
    background: #eef0f3;
    border: 1px solid #e7e8ec;
    margin-left: 6px;
}

QLabel#StatusChip[data-ok="1"] {
    background: #e3f4e9;
    border: 1px solid #c4e6d0;
    color: #1d6f3d;
}

QLabel#StatusChip[data-warn="1"] {
    background: #fdf3dd;
    border: 1px solid #f0e0b8;
    color: #8a6116;
}

/* ---------- header tabs ---------- */
QPushButton#HeaderTab {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #8a8d96;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#HeaderTab:hover { color: #17181c; background: #eef0f3; }

QPushButton#HeaderTab:checked { color: #2f6fd6; background: #e8f0fd; }

QPushButton#HeaderTab:focus { border: none; }

/* ---------- pages ---------- */
#ContentArea { background: #f5f6f8; }

#PageCard {
    background: #ffffff;
    border: 1px solid #e7e8ec;
    border-radius: 14px;
}

#GroupTitle {
    color: #17181c;
    font-size: 13px;
    font-weight: 600;
}

#HintLabel {
    color: #8a8d96;
    font-size: 12px;
}

/* 提示语变成「当前做不了这件事」时的样子：入口置灰的同时必须让原因可见 ——
   禁用控件未必收得到 tooltip。写方 setProperty("data-err", 1) 即可复用。 */
#HintLabel[data-err="1"] { color: #c0392b; }

/* 看板娘页「模型」卡片刷新行右端的问号徽标(2026-09-18 起取代原来那段
   「把 Cubism3/4 模型整个文件夹放进…」的常驻说明文字，内容移进它的 tooltip)。
   QLabel + 22×22 定尺 + 半宽圆角 = 正圆；**不要写 padding**。 */
#HelpBadge {
    color: #8a8d96;
    border: 1px solid #d9dbe1;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
}

#HelpBadge:hover {
    color: #17181c;
    border: 1px solid #2f6fd6;
}

QLabel#FieldLabel {
    color: #5f6470;
    font-size: 12px;
}

/* ---------- preset cards ---------- */
QPushButton#PresetCard {
    background: #f7f8fa;
    border: 1px solid #e7e8ec;
    border-radius: 10px;
    padding: 3px;
}

QPushButton#PresetCard:hover {
    border: 1px solid #d3d6dd;
    background: #f2f3f6;
}

QPushButton#PresetCard:checked {
    border: 2px solid #2f6fd6;
    background: #f7f8fa;
}

QLabel#PresetName {
    color: #5f6470;
    font-size: 11px;
}

/* ---------- focus ---------- */
QComboBox:focus { border: 1px solid #2f6fd6; }

QPushButton:focus { border: 1px solid #2f6fd6; }
QPushButton#PrimaryButton:focus { border: none; background: #3a7ae2; }

QPushButton#PrimaryButton[data-active="0"] {
    background: transparent;
    border: 1px solid #d9dbe1;
    color: #5f6470;
    font-weight: 600;
}

QPushButton#PrimaryButton[data-active="0"]:hover { background: #f2f3f6; }

QPushButton#PrimaryButton[data-active="0"]:focus {
    border: 1px solid #2f6fd6;
    background: transparent;
}

QPushButton#PrimaryButton[data-active="0"]:disabled { border: 1px solid #e7e8ec; }

QPushButton#PrimaryButton[data-active="1"] {
    background: #c0392b;
    border: none;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#PrimaryButton[data-active="1"]:hover { background: #d44637; }
QPushButton#PrimaryButton[data-active="1"]:pressed { background: #a93226; }
QPushButton#PrimaryButton[data-active="1"]:disabled { background: #f0d2d0; color: #8a5a5e; border: 1px solid #f0d2d0; }

QListWidget#NavList:focus { border: none; }
QSlider:focus { background: transparent; }
QCheckBox { border: none; }
QCheckBox:focus { border: none; }
QCheckBox::indicator:focus { border: 1px solid #2f6fd6; }
QRadioButton { border: none; }
QRadioButton:focus { border: none; }
QSlider { border: none; }
QSlider:focus { border: none; }

/* ---------- scrollbars ---------- */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #d3d6dd;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #c1c4cc; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #d3d6dd;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- sliders ---------- */
QSlider { min-height: 22px; }

QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: #e3e4e9;
}

QSlider::sub-page:horizontal {
    background: #2f6fd6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 6px;
    border: 1px solid #d3d6dd;
}

QSlider::handle:horizontal:hover { border: 1px solid #2f6fd6; }

/* ---------- combo / checkbox ---------- */
QComboBox {
    background: rgba(120, 122, 130, 0.10);
    color: #17181c;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 6px 10px 6px 12px;
    font-size: 13px;
    min-height: 18px;
}

QComboBox:hover { background: rgba(120, 122, 130, 0.16); }
QComboBox:pressed { background: rgba(120, 122, 130, 0.22); }
QComboBox:disabled { background: rgba(120, 122, 130, 0.05); color: #a4a7b0; }

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8a8d96;
    margin-right: 9px;
}

QComboBox:disabled::down-arrow { border-top-color: #c3c6cd; }

/* The popup is a top-level frame of its own, and that frame owns the rounded
   panel; C++ clips its corners to the same radius and insets the list by 6px, which
   Qt counts when it sizes the popup, so every row gets shown and none of them is
   flush against a corner. The list in front of the panel stays a flat inner surface,
   so the two never read as a border inside a border. */
QFrame#ComboContainer {
    background: #ffffff;
    border: 1px solid #e2e4ea;
    border-radius: 12px;
}

QAbstractItemView#ComboPopup {
    background: #ffffff;
    color: #17181c;
    border: none;
    padding: 0;
    outline: none;
    show-decoration-selected: 0;
    /* The row height in C++ is measured from this font, so it belongs on the list
       itself rather than on ::item, where it would only be applied while painting. */
    font-size: 13px;
}

QAbstractItemView#ComboPopup::item {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 2px 3px;
    color: #17181c;
}

QAbstractItemView#ComboPopup::item:hover { background: #f2f3f6; }

QAbstractItemView#ComboPopup::item:selected {
    background: #e8f0fd;
    color: #1c4fa0;
    font-weight: 600;
}

/* ---------- popup menus (看板娘右键菜单 / 托盘菜单) ----------
   与 #ComboContainer、QToolTip 同属一族「浮层表面」：细描边 + 扁平底色，
   只是内容换成了动作列表。

   尺度整体收小一档(2026-09-17)：字 13→12px(与正文 12px 对齐)、外内边距 4→3px、
   行内边距 5→4px、行外边距 2→1px、分隔线 3/8→2/6px。

   **外框刻意不留圆角**(2026-09-17 二次调整，实测结论)：
   QMenu 是顶层弹窗，QSS 的 border-radius 只改「画出来的那块矩形」，窗口本身仍是
   方的，圆角外侧会露出窗口底色。以前靠给窗口设 region 遮罩收口
   (menustyle::applyRoundedCorners)，但 region 是 **1 位 alpha**，圆角边缘必然是
   硬台阶；在 150% 缩放(DPI 144)下逻辑坐标转设备坐标还会把台阶放大，肉眼就是
   「圆角有粗糙像素点」。改走逐像素透明(WA_TranslucentBackground)实测更糟 ——
   圆角外侧直接渲染成黑块。所以外框改成直角：不留半径就不需要遮罩，也就没有
   台阶可看。菜单项的高亮块画在窗口**内部**、带抗锯齿，保留小圆角不受影响。 */
QMenu {
    background: #ffffff;
    border: 1px solid #e2e4ea;
    padding: 3px;
    color: #17181c;
    font-size: 12px;
}

/* 行高：12px 字的一行约 24px(上下内边距 4px + 外边距 1px)，比上一版矮一档。
   历史：最早是 8px/2px，出来 37px 一行，十项的菜单拉到 360px 高，鼠标要跑很远
   才够得着下一项，所以一路压到现在的 4px/1px。 */
QMenu::item {
    background: transparent;
    color: #17181c;
    padding: 4px 13px 4px 8px;
    margin: 1px 1px;
    border-radius: 5px;
    /* 只是「不许窄成一条」，不是目标宽度：真正的宽度由最长的那行文字定
       (现为「暂停 / 恢复」)。改菜单文案会直接改变菜单宽度 —— 原来 124px 是
       「打开主界面设置」撑出来的(菜单 176px)，那句缩成「打开设置」后会跟着变窄。 */
    min-width: 76px;
}

/* 菜单没有 hover 态，高亮就是 :selected */
QMenu::item:selected { background: #f2f3f6; color: #17181c; }

/* 不可点的项(「切换动作」在只有待机动作的模型上)灰得更明确：
   比正文浅、比分隔线深，一眼能看出是「不可用」而不是「没画出来」 */
QMenu::item:disabled { color: #a4a7b0; }

QMenu::separator {
    height: 1px;
    background: #eceef2;
    margin: 2px 6px;
}

/* 勾选项(「鼠标穿透」「窗口置顶」)：用填色圆角块表示选中，
   与 QCheckBox::indicator 同一套语言，也就不需要额外的对勾位图资源。
   未选中时给一块极浅的底，让「这是个开关」这件事在未开启时也看得出来。
   尺寸随字号一起收小：13→12px，圆角 4→3px。 */
QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 7px;
    border-radius: 3px;
    background: rgba(120, 122, 130, 0.14);
}

QMenu::indicator:checked { background: #2f6fd6; }

QMenu::indicator:disabled { background: rgba(120, 122, 130, 0.07); }

/* 二级菜单箭头(托盘菜单的「动态壁纸」「看板娘」)：**刻意不覆盖**，交给 Fusion 画。
   原因是试过之后发现 QSS 这条路走不通：
   1) 用 border 拼三角在这里出不来三角。Qt 只在四条边框颜色**互不相同**时才按
      CSS 那样做斜接；上下写成 `transparent` 会被当成「没有这条边框」，于是只剩
      左侧那条 5px 被画成 5x8 的实心块(实测字符图确认)。上下改写成不透明的菜单
      底色虽然能出三角，但颜色被写死，菜单项高亮(#f2f3f6)时会在高亮块上啃出
      两个白色楔形缺口。
   2) 贴图能出正确的形状，但要多两个资源文件(明/暗各一)，为 5x8 像素的箭头不值。
   不覆盖的代价是箭头颜色不再由这里的 QSS 决定 —— 但实测它跟着 `color` 走：
   暗色下箭头像素实测 #b3b3b5，落在 #212228 的菜单底上清晰可见；禁用态由 Fusion
   自动画淡，比手写一个 #d5d8de 更准。 */

QCheckBox {
    color: #5f6470;
    font-size: 12px;
    spacing: 8px;
}

QCheckBox:hover { color: #17181c; }

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 5px;
    background: rgba(120, 122, 130, 0.14);
}

QCheckBox::indicator:hover { background: rgba(120, 122, 130, 0.26); }

QCheckBox::indicator:checked {
    background: #2f6fd6;
    border: none;
}

/* 播放模式单选框：外圈常驻描边，选中时内圈填色(纯 QSS，无位图资源) */
QRadioButton {
    color: #5f6470;
    font-size: 12px;
    spacing: 5px;
}

QRadioButton:hover { color: #17181c; }

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #b6b9c2;
    border-radius: 8px;
    background: transparent;
}

QRadioButton::indicator:hover { border-color: #8b8f99; }

QRadioButton::indicator:focus { border-color: #2f6fd6; }

QRadioButton::indicator:checked {
    border-color: #2f6fd6;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0.0 #2f6fd6, stop: 0.42 #2f6fd6,
        stop: 0.52 rgba(47, 111, 214, 0), stop: 1.0 rgba(47, 111, 214, 0));
}

/* ---------- buttons ---------- */
QPushButton {
    background: transparent;
    color: #5f6470;
    border: 1px solid #d9dbe1;
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background: #f2f3f6;
    border: 1px solid #c1c4cc;
    color: #17181c;
}

QPushButton:disabled { color: #b3b6bf; border: 1px solid #e7e8ec; }

QPushButton#PrimaryButton {
    background: #2f6fd6;
    border: none;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 18px;
    font-size: 13px;
    border-radius: 10px;
}

QPushButton#PrimaryButton:hover { background: #3a7ae2; }
QPushButton#PrimaryButton:pressed { background: #275cb0; }
QPushButton#PrimaryButton:disabled { background: #eceef1; color: #a4a7b0; border: 1px solid #e7e8ec; }

QPushButton#DangerButton {
    background: transparent;
    border: 1px solid #f0d2d0;
    color: #c0392b;
    border-radius: 10px;
    /* Sits in the same row as PrimaryButton: the 1px border eats one of the
       10px/18px paddings, so use 9/17 to land on the identical outer box. */
    padding: 9px 17px;
    font-size: 13px;
}

QPushButton#DangerButton:hover { background: #fdf1f0; border: 1px solid #e8b4b0; }

/* ---------- preview ---------- */
#PreviewFrame {
    background: #eceef1;
    border: 1px solid #e7e8ec;
    border-radius: 10px;
}

#PreviewLabel { color: #8a8d96; font-size: 12px; }

/* ---------- log ---------- */
#LogLabel {
    color: #4d6b5c;
    font-size: 12px;
}

#LogLabel[data-err="1"] { color: #c0392b; }

/* ---------- video playlist ---------- */
/* 视频列表操作键: 按语义配色(扫描=青绿查找/添加=蓝主操作/删除=红危险/清空=橙批量) */
QPushButton#LibraryScanButton {
    background: #0e8074; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#LibraryScanButton:hover { background: #129084; }
QPushButton#LibraryScanButton:pressed { background: #0b665d; }

QPushButton#LibraryDeleteButton {
    background: #d0403a; border: none; color: #ffffff;
    font-weight: 600; border-radius: 10px; padding: 8px 14px; font-size: 13px;
}
QPushButton#LibraryDeleteButton:hover { background: #e0524c; }
QPushButton#LibraryDeleteButton:pressed { background: #b0332e; }
QPushButton#LibraryDeleteButton:disabled { background: #e7e8ec; color: #9a9daa; }

/* 媒体库卡片(视频/网页两页共用)：扫描=青绿、删除=红、无勾选置灰 */
/* 网页库/视频库共用同一套树形列表外观 */
QTreeWidget#LibraryTree {
    font-size: 14px;
    background: #fafbfc;
    border: 1px solid #e7e8ec;
    border-radius: 10px;
    padding: 4px;
    color: #3d4048;
}

QTreeWidget#LibraryTree::item {
    border-radius: 8px;
    margin: 2px 2px;
    padding: 13px 12px;
}

QTreeWidget#LibraryTree::item:hover { background: #f2f3f6; }
QTreeWidget#LibraryTree::item:selected { background: #b9d6fb; color: #17181c; }

/* 分支格透明：原生样式会在选中行的分支格上画一块空的高亮圆角块(行首的怪方框) */
QTreeWidget#LibraryTree::branch { background: transparent; }

QTreeWidget#LibraryTree QHeaderView::section {
    font-size: 12px;
    background: #f1f2f5;
    border: none;
    border-bottom: 1px solid #e7e8ec;
    color: #5f6470;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 600;
}


/* ---------- gallery list ---------- */
QListWidget#GalleryList {
    background: transparent;
    border: none;
}

QListWidget#GalleryList[modelCards="true"],
QListWidget#GalleryList[imageCards="true"] {
    color: #5f6470;
}

QListWidget#GalleryList::item {
    background: #f7f8fa;
    border: 1px solid #e7e8ec;
    border-radius: 10px;
    margin: 3px;
    padding: 6px 2px;
    color: #8a8f99;
}

/* 标题文字颜色恒定(浅色)，选中/悬停只变化边框与背景 */
QListWidget#GalleryList::item:hover {
    border: 1px solid #d3d6dd;
    background: #f2f3f6;
}

QListWidget#GalleryList::item:selected {
    background: #f7f8fa;
    border: 2px solid #2f6fd6;
}

/* ---------- custom title bar ---------- */
QFrame#TitleBar {
    background: #f2f3f6;
    border-bottom: 1px solid #e7e8ec;
}

QLabel#TitleText {
    color: #1c2b45;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#TitleButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5f6470;
    font-size: 13px;
}

QPushButton#TitleButton:hover {
    background: #e3e5ea;
    color: #1c2b45;
}

QPushButton#TitleCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5f6470;
    font-size: 13px;
}

QPushButton#TitleCloseButton:hover {
    background: #c42b1c;
    color: #ffffff;
}

/* ---------- display position grid ---------- */
QPushButton#PosButton {
    background: #f7f8fa;
    border: 1px solid #e7e8ec;
    border-radius: 8px;
    padding: 4px 2px;
    color: #5f6470;
}

QPushButton#PosButton:hover {
    border: 1px solid #d3d6dd;
    background: #f2f3f6;
}

QPushButton#PosButton:checked {
    border: 2px solid #2f6fd6;
    background: #e3ecfb;
    color: #1c2b45;
}

QPushButton#PosButton:disabled {
    color: #b6b9c2;
    background: #f2f3f6;
    border: 1px solid #eceef2;
}

QPushButton#ParamResetButton {
    background: transparent;
    border: 1px solid #e0e2e8;
    border-radius: 6px;
    padding: 2px 10px;
    color: #8a8f99;
    font-size: 11px;
}

QPushButton#ParamResetButton:hover {
    border: 1px solid #2f6fd6;
    color: #1c2b45;
}

/* ---------- 悬浮提示(QToolTip) ----------
   默认提示沿用系统黄色气泡，与浅色卡片完全不搭；这里统一成与下拉浮层同源的白色浮层。
   QToolTip 的窗口尺寸不含边框，故用 padding 让出 1px 边界，避免文字被裁。 */
QToolTip {
    background-color: #ffffff;
    color: #3a4150;
    border: 1px solid #d9dce3;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
}
