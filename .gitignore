# build output
build*/
deploy/
*.log
*.bak
CMakeCache.txt

# user-specific
*.user
*.autosave
.vs/
.vscode/

# archives & temp
*.zip
.idea/
cmake-build-debug

dist/
# tools/ 下基本是本地验证探针，不入库。但版本号脚本属于发布流程的一环，
# 必须跟着仓库走，所以这里先整体忽略再单独放行它一个。
# 注意必须写 tools/*（不能写 tools/）：带斜杠的写法会把整个目录排除掉，
# git 不再往里看，后面的 ! 放行就完全无效。
tools/*
!tools/bump_version.py
new-build/
live2d-build/
data/
third_party/
.workbuddy-ai/
scripts
# 测试代码用完即删、不进版本库（2026-09-18 定案）。
#
# 保留这一行是**兜底**：临时写出来的 tests/ 别被误提交。项目里现在已经没有任何
# 测试目标了 —— tests/ 源码、cmake/{ControllerTests,RenderTests,UiTests}.cmake 与对应的
# YUMEIREN_BUILD_*_TESTS 选项都已删除，回归验证靠 tools/ 下的探针（那批本就不入库）。
tests

# 软件自身缓存(<程序目录>\.cache)
.cache/
