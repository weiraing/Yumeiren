# build output
build*/
deploy/
*.log
*.bak
CMakeCache.txt

# user-specific
*.user
*.autosave
.vs/
.vscode/

# archives & temp
*.zip
.idea/
cmake-build-debug

dist/
# tools/ 下基本是本地验证探针，不入库。但版本号脚本属于发布流程的一环，
# 必须跟着仓库走，所以这里先整体忽略再单独放行它一个。
# 注意必须写 tools/*（不能写 tools/）：带斜杠的写法会把整个目录排除掉，
# git 不再往里看，后面的 ! 放行就完全无效。
tools/*
!tools/bump_version.py
new-build/
live2d-build/
data/
third_party/
.workbuddy-ai/
scripts
tests
!/tests/
/tests/*
!/tests/kanban/
/tests/kanban/*
!/tests/kanban/CubismLifecycleTest.cpp
!/tests/kanban/KanbanControllerTest.cpp
# tests/ui/ 同理：整个目录先忽略，再放行要入库的用例。
# 漏写这条 ! 的后果是**静默不入库** —— git status 里连 untracked 都不显示，
# 只有 `git check-ignore -v <path>` 能问出是谁挡的（2026-09-18 踩过）。
!/tests/ui/
/tests/ui/*
!/tests/ui/TooltipStyleTest.cpp

# 软件自身缓存(<程序目录>\.cache)
.cache/
